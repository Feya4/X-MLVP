# Evaluation
# ----------------------------
def evaluate(prompt_learner, xai_module, val_loader, device, show_per_class: bool = False):
    # CHANGED: `show_per_class` now defaults to False. Previously this
    # printed the full per-class breakdown on *every* call, i.e. every
    # single epoch of both stages (100 times per run) -- almost all of
    # that output was immediately-overwritten noise, since only the final
    # best model's per-class numbers are actually useful to look at. The
    # per-epoch calls in main() below now leave this at the default
    # (overall accuracy only); a single call with show_per_class=True runs
    # once at the very end, after training, on the best checkpoint.
    prompt_learner.eval()
    correct = total = 0
    preds, truths = [], []

    with torch.no_grad():
        for batch in val_loader:
            x, y = batch
            x, y = x.to(device), y.to(device)
            logits, _ = prompt_learner(x)
            pred = logits.argmax(1)
            preds.append(pred.cpu())
            truths.append(y.cpu())
            total += y.size(0)
            correct += (pred == y).sum().item()

    preds = torch.cat(preds)
    truths = torch.cat(truths)

    if show_per_class:
        print("\nPer-Class Accuracy:")
        for cls in sorted(truths.unique().tolist()):
            mask = (truths == cls)
            acc = (preds[mask] == truths[mask]).float().mean().item() * 100
            label = PROMPT_NAMES[cls].title()
            print(f"  {label:25s}: {acc:5.1f}%")

    return 100.0 * correct / total


# ----------------------------
# Resume Helper
# ----------------------------
def _partial_load(module: nn.Module, checkpoint_state: dict, module_name: str) -> bool:
    """
    Loads only the keys that exist in *both* the checkpoint and the current
    module AND have matching shapes; everything else is left at its
    (freshly initialized) value. Returns True if the load was "clean"
    (every checkpoint key that still exists by name also matched by shape),
    False if anything had to be dropped or reinitialized because the
    architecture actually changed underneath that name.

    This subsumes the earlier XAIModule-specific fix (dropping stale
    "visual.*" backbone keys) as a special case, and additionally handles
    same-named-but-differently-shaped parameters, which is what you hit
    with prompt_learner: "W_t.weight" exists in both the old and new
    prompt_learner, but as (16, 1024) vs (16, 8192) -- same name, genuinely
    different tensor, because the conditional intervention now operates in
    the LLM's 4096-dim space instead of CLIP's ~512/768-dim space. A name
    match alone is not enough to safely reuse a weight.
    """
    current_state = module.state_dict()
    to_load = {}
    reinitialized = []
    for k, v in checkpoint_state.items():
        if k not in current_state:
            reinitialized.append((k, "no longer exists in this architecture"))
            continue
        if tuple(v.shape) != tuple(current_state[k].shape):
            reinitialized.append((k, f"shape changed {tuple(v.shape)} -> {tuple(current_state[k].shape)}"))
            continue
        to_load[k] = v

    missing_from_ckpt = [k for k in current_state.keys() if k not in checkpoint_state]

    module.load_state_dict(to_load, strict=False)

    clean = len(reinitialized) == 0 and len(missing_from_ckpt) == 0
    print(f"[{module_name}] loaded {len(to_load)}/{len(current_state)} tensor(s) from checkpoint.")
    if reinitialized:
        print(f"[{module_name}] {len(reinitialized)} checkpoint tensor(s) could NOT be reused "
              f"(architecture changed) -- left at fresh initialization instead:")
        for k, reason in reinitialized[:8]:
            print(f"    {k}: {reason}")
        if len(reinitialized) > 8:
            print(f"    ... and {len(reinitialized) - 8} more")
    if missing_from_ckpt:
        print(f"[{module_name}] {len(missing_from_ckpt)} tensor(s) in the current model have no "
              f"matching checkpoint entry at all (new parameters since that checkpoint was saved): "
              f"{missing_from_ckpt[:8]}{'...' if len(missing_from_ckpt) > 8 else ''}")
    return clean


def load_best_model_if_exists(prompt_learner, xai_module, optimizer=None, scheduler=None):
    if not os.path.exists(SAVE_PATH):
        print(f"No checkpoint found at {SAVE_PATH}. Starting from scratch.")
        return 0.0, 0
    ckpt = torch.load(SAVE_PATH, map_location=DEVICE)

    # FIXED: previously a plain, strict `load_state_dict` on both modules --
    # broke on the XAIModule's stale backbone keys (fixed earlier) and now
    # breaks again on prompt_learner, for a different and more fundamental
    # reason: prompt_learner's architecture actually changed (Eq. 6-11 are
    # now implemented against a real frozen LLM in Dr=4096 space, replacing
    # the old CLIP-embedding-space version) -- "A", "B", "R", "desc_embs.*",
    # "W_z.*" no longer exist, and same-named tensors like "W_t.weight" now
    # have a different shape. `_partial_load` below reuses whatever
    # genuinely still matches (e.g. `ctx`, which didn't change shape) and
    # reinitializes the rest, rather than crashing.
    prompt_clean = _partial_load(prompt_learner, ckpt['prompt_learner'], "prompt_learner")
    xai_clean = _partial_load(xai_module, ckpt['xai_module'], "xai_module")

    best_acc = ckpt.get('best_acc', 0.0)

    if not prompt_clean:
        # IMPORTANT: prompt_learner is now, for practical purposes, a
        # different model -- most of its trainable weights just got
        # reinitialized from scratch above, not warm-started. Two
        # consequences, both handled here rather than left as a footgun:
        #
        # 1. The optimizer's saved state (AdamW's per-parameter momentum
        #    and variance buffers) was computed for the *old* parameter
        #    tensors. Loading it against the new parameter list would at
        #    best silently pair momentum buffers with the wrong (differently
        #    -shaped or newly-initialized) parameters, and at worst raise
        #    its own shape-mismatch error inside `optimizer.load_state_dict`.
        #    Skipping it and starting the optimizer fresh is the only
        #    correct option here.
        # 2. Continuing the LR schedule from wherever the old run left off
        #    (e.g. deep into cosine annealing, LR already near eta_min)
        #    would badly undertrain the reinitialized prompt_learner
        #    weights, which need a real learning-rate budget to learn from
        #    scratch. Restarting the schedule at epoch 0 is intentional.
        print("\nprompt_learner's architecture changed since this checkpoint was saved -- "
              "most of its weights were just reinitialized (see above), not restored. "
              "Optimizer and LR-schedule state will NOT be restored (they were computed "
              "for the old, now-nonexistent parameter tensors), and training will restart "
              "the epoch/stage schedule from epoch 1 rather than continuing mid-schedule.")
        print(f"Note: best_acc={best_acc:.2f}% is carried over from the OLD architecture and is "
              f"not a meaningful estimate of what the new (largely reinitialized) prompt_learner "
              f"can currently achieve -- expect validation accuracy to start well below this and "
              f"climb back up as it re-learns, which also means new checkpoints won't get saved "
              f"until it actually re-surpasses {best_acc:.2f}%, i.e. for a while.")
        return best_acc, 0

    # Both modules loaded cleanly (every checkpoint tensor still matches by
    # name and shape) -- this is the "just resuming an interrupted run with
    # the same code" case, so it's safe to also restore epoch/optimizer/
    # scheduler state for a true resume.
    start_epoch = ckpt.get('epoch', -1) + 1
    if optimizer is not None and 'optimizer' in ckpt:
        try:
            optimizer.load_state_dict(ckpt['optimizer'])
        except Exception as e:
            print(f"Could not restore optimizer state ({e}); continuing with a fresh optimizer.")
    if scheduler is not None and 'scheduler' in ckpt:
        try:
            scheduler.load_state_dict(ckpt['scheduler'])
        except Exception as e:
            print(f"Could not restore scheduler state ({e}); continuing with a fresh scheduler.")

    if start_epoch > 0:
        print(f"Resumed from checkpoint | Best Acc: {best_acc:.2f}% | "
              f"continuing from epoch {start_epoch+1}/{EPOCHS} "
              f"(skipping {start_epoch} already-completed epoch(s))")
    else:
        print(f"Resumed weights from checkpoint | Best Acc: {best_acc:.2f}% | "
              f"no epoch/optimizer/scheduler info in this checkpoint (old format), "
              f"so restarting the schedule from epoch 1 -- this will be the last "
              f"time that happens, future resumes from checkpoints saved by this "
              f"version will continue properly.")

    return best_acc, start_epoch


# ----------------------------
# Main Training Loop
# ----------------------------
def main():
    print("Starting X-MLVP Training on ISIC 2018...")
    set_seed(SEED)  # IMPROVED: see set_seed() above.

    # --- Data ---
    transform = get_transform(img_size=IMG_SIZE, use_stain_norm=False, stats="clip")
    train_dataset = ISIC2018Dataset(root_dir=DATA_DIR, annotations_path=ANNOTATIONS_PATH,
                                    transform=transform, train=True, split_ratio=SPLIT_RATIO, seed=SEED)
    val_dataset = ISIC2018Dataset(root_dir=DATA_DIR, annotations_path=ANNOTATIONS_PATH,
                                  transform=transform, train=False, split_ratio=SPLIT_RATIO, seed=SEED)

    train_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True, num_workers=2, pin_memory=True)
    val_loader = DataLoader(val_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=2, pin_memory=True)

    print(f"Train: {len(train_dataset)} | Val: {len(val_dataset)}")

    # --- Load CLIP ---
    clip_model, _, _ = load_local_biomedclip(MODEL_DIR, device=DEVICE)
    clip_model.eval()
    for p in clip_model.parameters():
        p.requires_grad = False

    # Attach custom method
    import types
    from prompt import encode_text_from_embs
    if not hasattr(clip_model, 'encode_text_from_embs'):
        clip_model.encode_text_from_embs = types.MethodType(encode_text_from_embs, clip_model)

    # --- Prompt Learner ---
    prompt_learner = XMLVPPromptLearner(
        clip_model=clip_model,
        class_names=PROMPT_NAMES,
        n_ctx=8,
        ctx_init="a dermoscopic image of",
        device=DEVICE,
        tokenizer_path=MODEL_DIR,
        llm_desc_dir=LLM_DESC_DIR,
        r=16
    ).to(DEVICE)

    # --- XAI Module ---
    xai_module = XAIModule(
        visual=clip_model.visual,
        gradcam_layer=clip_model.visual.transformer.resblocks[-1].ln_1,
        num_concepts=8,
        device=DEVICE
    ).to(DEVICE)

    # --- Optimizer ---
    optimizer = optim.AdamW([
        {'params': prompt_learner.parameters(), 'lr': LR_CTX},
        {'params': xai_module.concept_head.parameters(), 'lr': LR_CONCEPT},
        {'params': [xai_module.log_vars], 'lr': 1e-2}
    ], weight_decay=WEIGHT_DECAY)
    # NOTE: this explicit param-group list is exactly why the submodule-
    # registration issue fixed above never broke gradients -- you were
    # already careful to hand the optimizer only concept_head + log_vars,
    # not xai_module.parameters() wholesale. The fix above only stops the
    # frozen backbone from being *saved* in every checkpoint; it doesn't
    # change what gets trained, which was already correct.

    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=EPOCHS, eta_min=1e-6)
    scaler = GradScaler()

    # --- Resume ---
    best_acc = 0.0
    start_epoch = 0
    if RESUME:
        best_acc, start_epoch = load_best_model_if_exists(prompt_learner, xai_module, optimizer, scheduler)

    # ----------------------------
    # Training loop (Stage 1: prompt-only warm-up, epochs < STAGE1_EPOCHS;
    # Stage 2: full X-MLVP with explanation loss, epochs >= STAGE1_EPOCHS)
    # ----------------------------
    # FIXED (this is the actual fix for "why does it take long"): the
    # previous version had two separate `for epoch in range(...)` loops,
    # each always starting at its own fixed lower bound (0, then
    # STAGE1_EPOCHS) regardless of RESUME -- so every run redid the entire
    # 100-epoch schedule no matter how far a previous run had gotten. This
    # is now a single loop starting at `start_epoch` (0 for a fresh run,
    # or one past the last checkpointed epoch when resuming), with the
    # stage decided per-epoch instead of by which physical loop you're in.
    if start_epoch >= EPOCHS:
        print(f"Checkpoint's epoch ({start_epoch}) already reached EPOCHS ({EPOCHS}); nothing to train.")

    was_warmup = None  # tracks whether we've already applied the freeze/unfreeze for the current stage
    for epoch in range(start_epoch, EPOCHS):
        is_warmup = epoch < STAGE1_EPOCHS

        if is_warmup != was_warmup:
            # Only touch requires_grad / β right when we cross the stage
            # boundary (or on the very first iteration after a resume) --
            # cheap either way, but avoids re-printing the stage banner
            # every single epoch.
            if is_warmup:
                print(f"Stage 1: Prompt-only warm-up (epochs 1-{STAGE1_EPOCHS})")
                for param in xai_module.parameters():
                    param.requires_grad = False
                β = 0.0
            else:
                print(f"Stage 2: Full X-MLVP with explanation loss (epochs {STAGE1_EPOCHS+1}-{EPOCHS})")
                for param in xai_module.parameters():
                    param.requires_grad = True
                β = 0.05
            was_warmup = is_warmup

        prompt_learner.train()
        if not is_warmup:
            xai_module.train()
        running_loss = 0.0

        for batch in train_loader:
            optimizer.zero_grad(set_to_none=True)
            x, y = batch
            x, y = x.to(DEVICE), y.to(DEVICE)

            mixed_x, y_a, y_b, lam, mix_index = mixup_data(x, y, MIXUP_ALPHA, MIXUP_PROB)

            with autocast():
                logits, cache = prompt_learner(mixed_x)
                L_cls = mixup_criterion(nn.CrossEntropyLoss(), logits, y_a, y_b, lam)

                if is_warmup:
                    loss = L_cls
                else:
                    image_features = cache['image_features']
                    xai_outputs = xai_module(mixed_x, image_features, cache)

                    # NOTE (needs your decision, partially addressed): the
                    # original built `rationale_gt` from the *original,
                    # un-mixed* labels `y`:
                    #     rationale_gt = [prompt_learner.llm_descriptions[PROMPT_NAMES[label.item()]] for label in y]
                    # but the rationale in xai_outputs is generated from
                    # `mixed_x` (a pixel blend of x and x[mix_index]), so
                    # whenever lam is far from 1 the "ground truth"
                    # description used for L_lang doesn't really match what's
                    # in the image the model was actually looking at. A
                    # cheap partial fix: use the dominant label (y_a when
                    # lam >= 0.5, else y_b) rather than always y. A more
                    # thorough fix would skip the language/IoU losses on
                    # heavily-mixed samples entirely. Implemented the cheap
                    # version below since it's a one-line change that
                    # doesn't alter the rest of the pipeline; swap in the
                    # stricter version if L_lang quality matters to you.
                    dominant_y = y_a if lam >= 0.5 else y_b
                    rationale_gt = [
                        prompt_learner.llm_descriptions[PROMPT_NAMES[label.item()]]
                        for label in dominant_y
                    ]

                    L_iou = focal_iou_loss(xai_outputs["saliency"], xai_outputs["pseudo_mask"])
                    L_concept = nn.BCEWithLogitsLoss()(xai_outputs["concept_pred"],
                                                      torch.zeros_like(xai_outputs["concept_pred"]))
                    # NOTE (needs your decision, not changed): the target
                    # here is `torch.zeros_like(...)` unconditionally --
                    # i.e. every concept probe is trained to predict
                    # "absent" for every image, regardless of what's
                    # actually in it. If that's intentional (e.g. a
                    # sparsity regularizer discouraging the concept head
                    # from firing on everything), it'd be worth a comment
                    # saying so explicitly and maybe renaming this to
                    # `L_concept_sparsity`. If it's meant to be real concept
                    # supervision, it currently isn't providing any --
                    # ISIC2018 has no concept-level labels, so you'd need
                    # pseudo-labels (e.g. keyword-matching the LLM class
                    # description against your `num_concepts` concept
                    # names) before this loss can teach the probe anything
                    # image-specific. Left the zero-target behavior exactly
                    # as it was since changing it would change your trained
                    # results, which you said are already correct --
                    # flagging it so it's a deliberate choice rather than
                    # an implicit one.
                    L_lang = clip_text_sim_loss(xai_outputs["rationale"], rationale_gt,
                                                clip_model, prompt_learner.tokenizer)

                    L_xai = uncertainty_weighted_loss(L_iou, L_concept, L_lang, xai_module.log_vars)
                    loss = L_cls + β * L_xai

            scaler.scale(loss).backward()
            scaler.unscale_(optimizer)  # IMPROVED: needed before clipping
            torch.nn.utils.clip_grad_norm_(
                [p for g in optimizer.param_groups for p in g['params']], GRAD_CLIP_NORM
            )  # IMPROVED: added gradient clipping -- cheap insurance against
               # occasional large gradients under AMP + multi-term losses;
               # no-op if your gradients were already well-behaved.
            scaler.step(optimizer)
            scaler.update()
            running_loss += loss.item()

        val_acc = evaluate(prompt_learner, xai_module, val_loader, DEVICE)
        scheduler.step()
        stage_label = "Stage 1" if is_warmup else "Stage 2"
        print(f"{stage_label} | Epoch {epoch+1}/{EPOCHS} | Loss: {running_loss/len(train_loader):.4f} | Val Acc: {val_acc:.2f}%")

        if val_acc > best_acc:
            best_acc = val_acc
            torch.save({
                'prompt_learner': prompt_learner.state_dict(),
                'xai_module': xai_module.state_dict(),
                'best_acc': best_acc,
                'epoch': epoch,                          # IMPROVED: added, see resume fix above
                'optimizer': optimizer.state_dict(),      # IMPROVED: added
                'scheduler': scheduler.state_dict(),      # IMPROVED: added
            }, SAVE_PATH)
            print(f"Best model saved: {best_acc:.2f}% (epoch {epoch+1})")

    print(f"Training complete. Best accuracy: {best_acc:.2f}%")

    # ADDED: per-class accuracy for the *best* checkpoint, printed exactly
    # once, after all training is done -- this is what you asked for. Note
    # this deliberately reloads SAVE_PATH rather than just evaluating
    # whatever weights happen to be live at the end of the loop: if the
    # best val_acc was reached at, say, epoch 87 and epochs 88-100 didn't
    # improve on it, the live weights at epoch 100 are *not* the best
    # model, and per-class numbers computed on them wouldn't match
    # `best_acc` above. Reloading SAVE_PATH guarantees "best model" really
    # means the best one, regardless of which epoch it came from.
    print(f"\nLoading best checkpoint (best_acc={best_acc:.2f}%) for final per-class report...")
    final_best_acc, _ = load_best_model_if_exists(prompt_learner, xai_module, optimizer=None, scheduler=None)
    final_overall_acc = evaluate(prompt_learner, xai_module, val_loader, DEVICE, show_per_class=True)
    print(f"\nFinal best-model overall accuracy: {final_overall_acc:.2f}% "
          f"(checkpoint's recorded best_acc: {final_best_acc:.2f}%)")


if __name__ == "__main__":
    main()
