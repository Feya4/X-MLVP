class XAIModule(nn.Module):
    def __init__(self, visual, gradcam_layer, num_concepts=8, device="cuda"):
        super().__init__()
        self.device = device

        # FIXED: `self.visual = visual` and `self.gradcam_layer = gradcam_layer`
        # in the original assign *nn.Module* objects as attributes of an
        # nn.Module. PyTorch auto-registers any nn.Module attribute as a
        # submodule -- so `xai_module.parameters()`, `xai_module.state_dict()`,
        # and `xai_module.to(device)` were silently sweeping in the *entire
        # frozen CLIP visual backbone* every time. You avoided the gradient
        # problem by only ever passing `xai_module.concept_head.parameters()`
        # to the optimizer (good instinct), but every `torch.save({...,
        # 'xai_module': xai_module.state_dict(), ...})` call was still
        # writing the full frozen ViT's weights into the checkpoint on top
        # of the small concept head -- almost certainly not what you want,
        # and it makes SAVE_PATH far larger than necessary. Storing the
        # reference in a plain (non-Module-registering) way avoids this
        # without changing any of the actual computation below.
        object.__setattr__(self, "visual", visual)
        object.__setattr__(self, "gradcam_layer", gradcam_layer)
        # `gradcam_layer` itself is accepted but never read anywhere in this
        # class (see get_saliency_map below) -- left in place since you may
        # be about to wire up true Grad-CAM (see note there), just flagging
        # that today it's an unused argument.

        # Fix: Use 512, not 768 -- because image_features is 512D
        d_in = 512  # clip_model.visual.proj.shape[-1] if available
        self.concept_head = nn.Linear(d_in, num_concepts).to(device)

        # Uncertainty weights
        self.log_vars = nn.Parameter(torch.zeros(3))  # L_iou, L_concept, L_lang

    def get_saliency_map(self, image):
        # NOTE (not changed, just documented): despite `image.requires_grad
        # = True` and `torch.enable_grad()`, this method never actually
        # calls `.backward()` on anything -- it builds the map purely from
        # a forward-pass patch-vs-CLS-token similarity, not from gradients.
        # That's a legitimate, cheap saliency technique in its own right,
        # but it is *not* Grad-CAM despite Fig. 3 in the paper being
        # captioned "Saliency Map (Grad-CAM)" -- and the requires_grad /
        # enable_grad machinery here does nothing useful for it (mild,
        # harmless overhead). If you do want literal Grad-CAM, that's what
        # the unused `gradcam_layer` argument above looks like it was meant
        # for: register a forward+backward hook on that layer, backprop the
        # target class logit, and combine activations with their gradients
        # in the usual Grad-CAM way. Left the current (working) behavior
        # unchanged since you said this version is correct as-is.
        self.visual.eval()
        image.requires_grad = True
        with torch.enable_grad():
            feats = forward_vision_features(self.visual, image)
            attn_scores = feats @ feats[:, :1].transpose(-1, -2)
            attn_scores = attn_scores[:, 1:, 0]
            B, L = attn_scores.shape
            grid_size = int(L ** 0.5)
            assert grid_size * grid_size == L, f"Patch count {L} not square"
            cam = attn_scores.reshape(B, grid_size, grid_size)
            cam = torch.nn.functional.interpolate(cam.unsqueeze(1), size=(IMG_SIZE, IMG_SIZE),
                                                 mode='bilinear', align_corners=False).squeeze(1)
            return cam

    def get_pseudo_mask(self, patch_features, use_exact_fill: bool = False):
        B, Lp1, D_patch = patch_features.shape  # [B, 197, 768]
        H = W = int((Lp1 - 1) ** 0.5)           # 14

        patch_tokens = patch_features[:, 1:]     # [B, 196, 768]

        # Project patches from 768-D to 512-D using CLIP's visual projection
        proj = self.visual.proj  # Shape: [768, 512]
        patch_tokens_512 = patch_tokens @ proj   # [B, 196, 512]
        flat_patches = patch_tokens_512.reshape(-1, 512)  # [B*196, 512]

        # Use concept head (512-D) to get disease direction
        with torch.no_grad():
            concept_weights = self.concept_head.weight.data[:3]  # [3, 512]
            # NOTE (not changed): "first 3 concept rows" as a stand-in
            # "disease direction" is arbitrary w.r.t. num_concepts=8 -- if
            # num_concepts ever changes, or the concept ordering changes,
            # this silently keeps averaging whichever 3 rows happen to be
            # first rather than anything semantically chosen. Consider
            # averaging *all* concept rows, or a named subset, instead of a
            # positional slice.
            concept_avg = concept_weights.mean(dim=0)            # [512]
            concept_avg = concept_avg / (concept_avg.norm() + 1e-8)

        # Compute similarity: [B*196, 512] @ [512] -> [B*196]
        scores = flat_patches @ concept_avg.to(flat_patches.device)
        importance_map = scores.reshape(B, H, W)

        # Normalize per sample
        min_val = importance_map.amin(dim=(1,2), keepdim=True)
        max_val = importance_map.amax(dim=(1,2), keepdim=True)
        importance_map = (importance_map - min_val) / (max_val - min_val + 1e-8)

        # Threshold: top 50%
        k = int(0.5 * H * W)
        flat_map = importance_map.view(B, -1)
        _, indices = torch.topk(flat_map, k=k, dim=1)
        binary_map = torch.zeros_like(flat_map).scatter_(1, indices, 1).view(B, H, W)

        # Fill holes
        if use_exact_fill:
            binary_np = binary_map.detach().cpu().numpy()
            for b in range(B):
                binary_np[b] = ndimage.binary_fill_holes(binary_np[b])
            binary_map = torch.tensor(binary_np, device=binary_map.device, dtype=torch.float32)
        else:
            # IMPROVED: GPU closing instead of a per-step CPU round-trip --
            # see _gpu_fill_holes_approx docstring above for why.
            binary_map = _gpu_fill_holes_approx(binary_map)

        # Upsample to IMG_SIZE x IMG_SIZE
        mask_full = torch.nn.functional.interpolate(
            binary_map.unsqueeze(1),
            size=(IMG_SIZE, IMG_SIZE),
            mode='nearest'
        ).squeeze(1)
        return mask_full

    def predict_concepts(self, image_features):
        # FIXED: this method was defined *twice* in the original class body.
        #     def predict_concepts(self, image_features):
        #         return torch.sigmoid(self.concept_head(image_features))
        #     def predict_concepts(self, image_features):
        #         x = image_features.mean(dim=1) if image_features.dim() == 3 else image_features
        #         return torch.sigmoid(self.concept_head(x))
        # Python doesn't error on this -- the second definition silently
        # replaced the first, which never ran. Kept the second (more
        # defensive) version, which handles both [B,D] and [B,T,D] inputs;
        # deleted the dead first copy.
        x = image_features.mean(dim=1) if image_features.dim() == 3 else image_features
        return torch.sigmoid(self.concept_head(x))

    def generate_rationale(self, pred_class, llm_desc_cache=None):
        desc = llm_desc_cache.get(pred_class, "no description") if llm_desc_cache else ""
        return f"Observed features like '{desc.split('.')[0]}'. Conclusion: consistent with {pred_class}."

    def forward(self, image, image_features, cache):
        outputs = {}
        patch_features = cache['patch_features']

        outputs["saliency"] = self.get_saliency_map(image)
        outputs["pseudo_mask"] = self.get_pseudo_mask(patch_features)
        outputs["concept_pred"] = self.predict_concepts(image_features)

        text_features = cache['text_features']
        similarity = torch.einsum('bd,bcd->bc', image_features, text_features)
        pred_indices = similarity.argmax(dim=1).clamp(0, len(PROMPT_NAMES) - 1)
        pred_classes = [PROMPT_NAMES[idx.item()] for idx in pred_indices]
        outputs["rationale"] = [
            self.generate_rationale(cls, cache.get("llm_descriptions"))
            for cls in pred_classes
        ]
        outputs["pred_indices"] = pred_indices  # IMPROVED: exposed so the
        # training loop can decide how to pick rationale ground truth for
        # mixed-up images (see Stage 2 loop) instead of re-deriving it.
        return outputs


# ----------------------------
# Loss Functions
# ----------------------------
def focal_iou_loss(cam, mask, alpha=0.8, gamma=2.0, eps=1e-8):
    inter = (cam * mask).sum((1,2))
    union = cam.sum((1,2)) + mask.sum((1,2)) - inter
    iou = (inter + eps) / (union + eps)
    loss = (1 - iou) ** gamma
    return (alpha * loss).mean()

def clip_text_sim_loss(pred_texts, gt_texts, model, tokenizer):
    if len(gt_texts) == 0 or len(pred_texts) == 0:
        return torch.tensor(0.0, requires_grad=True).to(DEVICE)

    try:
        # Tokenize
        encodings = tokenizer(gt_texts, padding=True, truncation=True, return_tensors='pt')
        input_ids = encodings['input_ids'].to(DEVICE)

        with torch.no_grad():
            gt_embs = model.encode_text_from_embs(input_ids).detach()

        pred_encodings = tokenizer(pred_texts, padding=True, truncation=True, return_tensors='pt')
        pred_input_ids = pred_encodings['input_ids'].to(DEVICE)
        pred_embs = model.encode_text_from_embs(pred_input_ids)

        sim = torch.cosine_similarity(pred_embs, gt_embs)
        return 1 - sim.mean()

    except Exception as e:
        print(f"Language loss failed: {str(e)}")
        return torch.tensor(0.0, requires_grad=True).to(DEVICE)

def uncertainty_weighted_loss(L_iou, L_concept, L_lang, log_vars):
    precision_iou = torch.exp(-log_vars[0])
    precision_concept = torch.exp(-log_vars[1])
    precision_lang = torch.exp(-log_vars[2])
    loss = (precision_iou * L_iou + log_vars[0] +
            precision_concept * L_concept + log_vars[1] +
            precision_lang * L_lang + log_vars[2])
    return 0.1 * loss  # Scale down


