# ----------------------------
# Mixup Augmentation
# ----------------------------
def mixup_data(x, y, alpha=0.4, prob=1.0):
    if alpha > 0 and torch.rand(1).item() < prob:
        lam = np.random.beta(alpha, alpha)
    else:
        lam = 1.0
    batch_size = x.size(0)
    index = torch.randperm(batch_size, device=x.device)
    mixed_x = lam * x + (1 - lam) * x[index]
    y_a, y_b = y, y[index]
    return mixed_x, y_a, y_b, lam, index  # IMPROVED: also return `index`,
    # see the Stage 2 loop -- needed to correctly pair rationale ground
    # truth with the mixed image (see note there).


def mixup_criterion(criterion, pred, y_a, y_b, lam):
    return lam * criterion(pred, y_a) + (1 - lam) * criterion(pred, y_b)


# ----------------------------
# GPU-friendly hole filling (see get_pseudo_mask)
# ----------------------------
def _gpu_fill_holes_approx(binary_map: torch.Tensor, kernel: int = 5) -> torch.Tensor:
    """Morphological closing (dilate then erode), computed as maxpool /
    -maxpool(-x), as a GPU-resident stand-in for scipy.ndimage.binary_fill_holes.

    IMPROVED: the original called `binary_map.cpu().numpy()` and then ran
    `ndimage.binary_fill_holes` in a Python `for b in range(B)` loop, *every
    training step*, inside an `autocast()` block. That forces a GPU->CPU
    sync plus a per-sample SciPy call on every batch for all ~100 epochs --
    in practice this is very often the single biggest wall-clock cost in a
    loop like this, well above the actual forward/backward pass, because it
    completely stalls GPU pipelining every iteration.

    This closing operation isn't pixel-identical to true connected-component
    hole filling (it won't reliably fill large holes that touch the mask's
    border), but for a soft IoU-loss target it is a very close, standard
    approximation, and it never leaves the GPU. Use `use_exact_fill=True` in
    get_pseudo_mask() to fall back to the original exact SciPy version for
    offline visualization / paper figures, where correctness matters more
    than throughput and you're not calling it every training step.
    """
    pad = kernel // 2
    x = binary_map.unsqueeze(1)
    dilated = F.max_pool2d(x, kernel, stride=1, padding=pad)
    closed = -F.max_pool2d(-dilated, kernel, stride=1, padding=pad)
    return closed.squeeze(1)


