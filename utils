def get_dataset_labels(dataset):
    """
    Safely get all labels from various dataset types.
    Supports: ImageFolder, Subset, XMLVPDataset (custom), etc.
    """
    if isinstance(dataset, torch.utils.data.Subset):
        return get_dataset_labels(dataset.dataset)

    if hasattr(dataset, 'targets'):
        # Common for MNIST, CIFAR, or datasets defining targets list
        return [dataset.targets[i] for i in range(len(dataset))]

    elif hasattr(dataset, 'samples'):
        # ImageFolder and similar
        return [sample[1] for sample in dataset.samples]

    elif hasattr(dataset, 'df') and 'label' in dataset.df.columns:
        # Assume it's a DataFrame-based dataset with 'label' column
        return dataset.df['label'].tolist()

    elif hasattr(dataset, 'data') and hasattr(dataset, 'labels'):
        # Some custom formats
        return dataset.labels

    elif hasattr(dataset, '__getitem__'):
        # Fallback: iterate through dataset
        print("⚠️ No direct label access found. Iterating via __getitem__...")
        labels = []
        for i in range(len(dataset)):
            _, y, *_ = dataset[i]  # Unpack: x, y, ...
            labels.append(y)
        return labels

    else:
        raise AttributeError(f"Cannot extract labels from dataset {type(dataset)}")
def get_trainable_params(module):
    """Returns a list of trainable parameters from a PyTorch module."""
    return [p for p in module.parameters() if p.requires_grad]
def forward_vision_features(visual, x: torch.Tensor):
        """
        Manual forward through open_clip's VisionTransformer to get patch features.
        Returns: patch features [B, L, D] before final pooling
        """
        # (1) Patch embedding
        x = visual.conv1(x)  # shape = [B, D, grid, grid]
        grid_size = x.shape[-1]
        x = x.reshape(x.shape[0], x.shape[1], -1)  # [B, D, L]
        x = x.permute(0, 2, 1)  # [B, L, D]

        # (2) Add class token and positional embedding
        x = torch.cat([visual.class_embedding.to(x.dtype).expand(x.shape[0], 1, -1), x], dim=1)
        x = x + visual.positional_embedding.to(x.dtype)
        x = visual.ln_pre(x)

        # (3) Transformer forward (we need intermediate activations)
        x = x.permute(1, 0, 2)  # NLD -> LND
        for r in visual.transformer.resblocks:
            x = r(x)
        x = x.permute(1, 0, 2)  # LND -> NLD
        x = visual.ln_post(x)

        return x  # [B, L+1, D]
def _fit_normalizer_from_reference_numpy(reference_path: str):
    global _NORMALIZER, _NORMALIZER_READY
    if not os.path.exists(reference_path):
        return
    ref_bgr = cv2.imread(reference_path)
    ref_rgb = cv2.cvtColor(ref_bgr, cv2.COLOR_BGR2RGB)
    _NORMALIZER = torchstain.normalizers.MacenkoNormalizer(backend="numpy")
    _NORMALIZER.fit(ref_rgb)
    _NORMALIZER_READY = True
