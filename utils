def load_local_biomedclip(MODEL_DIR, device="cuda"):
  
    import open_clip
    

    print(f"Loading BioMedCLIP from: {MODEL_DIR}")

    # Step 1: Create standard ViT-B-16 CLIP model (matches BioMedCLIP's vision encoder)
    model = open_clip.create_model("ViT-B-16", pretrained=None)
    
    # Step 2: Define paths
    config_path = os.path.join(MODEL_DIR, "open_clip_config.json")
    weights_path = os.path.join(MODEL_DIR, "open_clip_pytorch_model.bin")
    
    if not os.path.exists(weights_path):
        raise FileNotFoundError(f"Weights not found at: {weights_path}")

    # Step 3: Load state dict
    state_dict = torch.load(weights_path, map_location="cpu")
    
    # Handle key prefixes: remove 'module.' or 'model.' if present
    new_state_dict = {}
    for k, v in state_dict.items():
        k = k.replace("module.", "").replace("model.", "")
        new_state_dict[k] = v

    # Step 4: Load into model
    result = model.load_state_dict(new_state_dict, strict=False)
    print("Missing keys:", result.missing_keys)
    print("Unexpected keys:", result.unexpected_keys)

    # Step 5: Set up transforms
    preprocess = open_clip.image_transform(
        image_size=224,
        is_train=False,
        mean=(0.48145466, 0.4578275, 0.40821073),
        std=(0.26862954, 0.26130258, 0.27577711)
    )
    
    tokenizer = open_clip.get_tokenizer("ViT-B-16")

    # Step 6: Move to device
    model = model.to(device).eval()
    return model, preprocess, 224

def load_normalizer_pickle(pkl_path: str):
    global _NORMALIZER, _NORMALIZER_READY
    if os.path.exists(pkl_path):
        with open(pkl_path, "rb") as f:
            _NORMALIZER = pickle.load(f)
        _NORMALIZER_READY = True


def save_normalizer_pickle(pkl_path: str):
    if _NORMALIZER_READY and _NORMALIZER is not None:
        os.makedirs(os.path.dirname(pkl_path), exist_ok=True)
        with open(pkl_path, "wb") as f:
            pickle.dump(_NORMALIZER, f)


def stain_normalize(img: Image.Image) -> Image.Image:
    if not (_NORMALIZER_READY and _NORMALIZER is not None):
        return img
    arr = np.array(img)
    try:
        norm = _NORMALIZER.normalize(arr)
        return Image.fromarray(np.clip(norm, 0, 255).astype(np.uint8))
    except:
        return img


