# Always define get_transform, even if stain norm is not available
def get_transform(
    img_size=224,
    use_stain_norm=False,
    reference_path=None,
    normalizer_params=None,
    stats="clip",
    augment=False
):
    import torchvision.transforms as T
    from PIL import Image
    import numpy as np

    tfms = []

    # 1. Resize
    tfms.append(T.Resize((img_size, img_size), interpolation=T.InterpolationMode.BILINEAR))

    # 2. Stain normalization (PIL input)
    if use_stain_norm:
        global _NORMALIZER_READY
        if _NORMALIZER_READY:
            tfms.append(T.Lambda(stain_normalize))
        else:
            print("⚠️ Stain normalization requested but not ready; skipping.")

    # 3. Convert to tensor BEFORE any color jitter
    tfms.append(T.ToTensor())

    if augment:
        tfms.extend([
            T.RandomHorizontalFlip(p=0.5),
            T.RandomVerticalFlip(p=0.5),
            T.RandomRotation(degrees=15, fill=0),
            # ✅ Color jitter WITHOUT hue
            T.ColorJitter(brightness=0.1, contrast=0.1, saturation=0.1),
            # No hue!
            T.RandomResizedCrop(
                img_size,
                scale=(0.9, 1.0),
                ratio=(0.95, 1.05),
                interpolation=T.InterpolationMode.BILINEAR,
                antialias=True
            ),
        ])
    else:
        tfms.append(T.CenterCrop(img_size))

    # 4. Normalize
    if stats == "clip":
        mean = [0.48145466, 0.4578275, 0.40821073]
        std = [0.26862954, 0.26130258, 0.27577711]
    elif stats == "imagenet":
        mean = [0.485, 0.456, 0.406]
        std = [0.229, 0.224, 0.225]
    else:
        raise ValueError(f"Unknown stats: {stats}")

    tfms.append(T.Normalize(mean=mean, std=std))

    return T.Compose(tfms)

def _l2norm(x, dim=-1, eps=1e-12):
    return x / (x.norm(dim=dim, keepdim=True) + eps)
