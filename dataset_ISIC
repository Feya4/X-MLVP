# dataset.py
import torch
from torch.utils.data import Dataset
from PIL import Image
import pandas as pd
import os
import numpy as np

class ISIC2018Dataset(Dataset):
    def __init__(self, root_dir, annotations_path, transform=None, train=True, split_ratio=0.8, seed=42):
        self.transform = transform
        self.image_paths = []
        self.labels = []

        # Load annotations
        df = pd.read_csv(annotations_path)
        df['image_id'] = df['image'].apply(lambda x: x.split('/')[-1].split('.')[0])
        
        # Map one-hot to class index
        label_columns = ['MEL', 'NV', 'BCC', 'AKIEC', 'BKL', 'DF', 'VASC']
        df['label'] = df[label_columns].values.argmax(axis=1)

        # Assign paths
        for _, row in df.iterrows():
            img_id = row['image_id']
            img_path = os.path.join(root_dir, f"{img_id}.jpg")
            if os.path.exists(img_path):
                self.image_paths.append(img_path)
                self.labels.append(row['label'])

        # Split
        idx = np.arange(len(self.labels))
        split_idx = int(len(idx) * split_ratio)
        np.random.seed(seed)
        np.random.shuffle(idx)
        selected_idx = idx[:split_idx] if train else idx[split_idx:]

        self.image_paths = [self.image_paths[i] for i in selected_idx]
        self.labels = [self.labels[i] for i in selected_idx]

    def __len__(self):
        return len(self.labels)

    def __getitem__(self, idx):
        # Foreground-aware sampling
        while True:
            path = self.image_paths[idx]
            image = Image.open(path).convert("RGB")
            if self.is_foreground(image):
                break
            idx = torch.randint(0, len(self), ()).item()

        if self.transform:
            image = self.transform(image)

        label = self.labels[idx]
        return image, label

    def is_foreground(self, image, threshold=0.1):
        """
        Check if tile has lesion (not mostly background).
        For dermoscopy, use low threshold since skin is light.
        """
        gray = np.array(image.convert('L'))
        return np.mean(gray < 240) > threshold  # >10% non-white
